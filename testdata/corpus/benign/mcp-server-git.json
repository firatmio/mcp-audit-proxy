          }
        },
        "required": [
          "repo_path",
          "revision"
        ],
        "type": "object",
        "title": "showArguments"
      }
    },
    {
      "name": "git_status",
      "description": "Shows the working tree status",
      "inputSchema": {
        "properties": {
          "repo_path": {
            "title": "Repo Path",
            "type": "string"
          }
        },
        "required": [
          "repo_path"
        ],
        "type": "object",
        "title": "statusArguments"
      }
    }
  ]
}
